@startuml
' Жизненный цикл сущности "Пересдача" (электронная зачётка)
skinparam dpi 150
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam state {
  BackgroundColor #F2F2F2
  BorderColor #555555
}

[*] --> Создана : студент отправил запись

Создана --> Подтверждена : есть место, лимит попыток не исчерпан
Создана --> Отменена : нет мест или лимит исчерпан

Подтверждена --> Активна : наступил день пересдачи
Подтверждена --> Отменена : студент отменил запись

Активна --> Завершена : преподаватель выставил оценку
Активна --> Отменена : студент не явился

Завершена --> [*]
Отменена --> [*]
@enduml
