@startuml
' Набросок диаграммы классов: заказ такси
skinparam dpi 150
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 60
skinparam ranksep 60

class Пассажир {
  код
  имя
  телефон
}

class Водитель {
  код
  имя
  рейтинг
}

class Тариф {
  название
  базоваяЦена
  ценаЗаКм
  --
  рассчитать(км, мин)
}

class Заказ {
  номер
  адресПодачи
  адресНазначения
  стоимость
  статус
  --
  подтвердить()
  отменить()
}

enum СтатусЗаказа {
  СОЗДАН
  ПОДТВЕРЖДЁН
  АКТИВЕН
  ЗАВЕРШЁН
  ОТМЕНЁН
}

Пассажир "1" -- "0..*" Заказ : создаёт
Водитель "0..1" -- "0..*" Заказ : выполняет
Тариф "1" -- "0..*" Заказ : рассчитывается по
Заказ ..> СтатусЗаказа
@enduml
