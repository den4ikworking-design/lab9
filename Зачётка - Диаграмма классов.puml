@startuml
' Набросок диаграммы классов: запись на пересдачу
skinparam dpi 150
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 60
skinparam ranksep 60

class Студент {
  код
  ФИО
  группа
}

class Дисциплина {
  название
  формаКонтроля
}

class ДатаПересдачи {
  дата
  аудитория
  свободныхМест
}

class Пересдача {
  номерПопытки
  статус
  --
  записаться()
  отменить()
}

enum СтатусПересдачи {
  СОЗДАНА
  ПОДТВЕРЖДЕНА
  АКТИВНА
  ЗАВЕРШЕНА
  ОТМЕНЕНА
}

Студент "1" -- "0..*" Пересдача : записан
Дисциплина "1" -- "0..*" Пересдача : по дисциплине
ДатаПересдачи "1" -- "0..*" Пересдача : на дату
Дисциплина "1" -- "0..*" ДатаПересдачи : назначена на
Пересдача ..> СтатусПересдачи
@enduml
