@startuml
' Жизненный цикл сущности "Заказ" (такси)
skinparam dpi 150
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam state {
  BackgroundColor #F2F2F2
  BorderColor #555555
}

[*] --> Создан : пассажир оформил заказ

Создан --> Подтверждён : водитель принял заказ
Создан --> Отменён : водитель не найден или\nпассажир отменил (бесплатно)

Подтверждён --> Активен : водитель начал поездку
Подтверждён --> Отменён : пассажир отменил (штраф)

Активен --> Завершён : поездка завершена, оплата проведена

Завершён --> [*]
Отменён --> [*]
@enduml
